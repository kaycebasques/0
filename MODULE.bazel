module(
    name = "baremetal_pico",
)

# [source: examples/bazel/MODULE.bazel]
bazel_dep(name = "pigweed")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.17")

# Pin Pigweed repository revision containing hermetic LLVM/GCC ARM Cortex-M bare-metal cross toolchains
# [source: examples/bazel/MODULE.bazel]
git_override(
    module_name = "pigweed",
    commit = "c0def160076d3502e9b78c8c7a274f1fd60907be",
    remote = "https://pigweed.googlesource.com/pigweed/pigweed",
)

# Register Pigweed hermetic C/C++ cross-compiler toolchain for ARM Cortex-M0+ (ARMv6-M architecture)
# [source: docs/rp2040.pdf "1.2 Summary of Features"]
# [source: docs/dui0662b.pdf "1.1 About the processor"]
# [source: examples/bazel/MODULE.bazel]
register_toolchains(
    "@pigweed//pw_toolchain:cc_toolchain_cortex-m0",
    dev_dependency = True,
)

